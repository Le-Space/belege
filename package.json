{
  "name": "belege",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @belege/app dev",
    "bridge": "pnpm --filter @belege/bridge start",
    "demo": "node bridge/scripts/demo.mjs",
    "setup:hibiscus": "pnpm --filter @belege/bridge setup:hibiscus",
    "setup:mail": "pnpm --filter @belege/bridge setup:mail",
    "setup:llm": "pnpm --filter @belege/bridge setup:llm",
    "setup:portal": "pnpm --filter @belege/bridge setup:portal",
    "setup:kraken": "pnpm --filter @belege/bridge setup:kraken",
    "setup:paperless": "pnpm --filter @belege/bridge setup:paperless",
    "setup:enablebanking": "pnpm --filter @belege/bridge setup:enablebanking",
    "setup:coingecko": "pnpm --filter @belege/bridge setup:coingecko",
    "setup:bitcoin": "pnpm --filter @belege/bridge setup:bitcoin",
    "setup:alchemy": "pnpm --filter @belege/bridge setup:alchemy",
    "setup:blockscout": "pnpm --filter @belege/bridge setup:blockscout",
    "setup:relay": "pnpm --filter @belege/bridge setup:relay",
    "setup:aleph": "pnpm --filter @belege/bridge setup:aleph",
    "setup:origins": "pnpm --filter @belege/bridge setup:origins",
    "build": "pnpm --filter @belege/app build",
    "check": "pnpm --filter @belege/app check",
    "lint": "pnpm --filter @belege/app lint && pnpm --filter @belege/bridge lint && pnpm --filter \"./packages/*\" lint",
    "test:packages": "pnpm --filter \"./packages/*\" --if-present test",
    "test:unit": "pnpm --filter @belege/app test:unit",
    "test:e2e": "pnpm --filter @belege/app test:e2e",
    "test:e2e:stream": "pnpm --filter @belege/app test:e2e:stream",
    "test:bridge": "pnpm --filter @belege/bridge test",
    "test:skills": "node --test --test-reporter=spec skills/test/skills.test.js"
  },
  "version": "0.59.0"
}
