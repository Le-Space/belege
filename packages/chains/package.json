{
	"name": "@le-space/chains",
	"version": "0.2.0",
	"description": "Own wallets on public chains, read only, by their address – Cosmos (Nyx, Akash), EVM (Blockscout, Alchemy), Bitcoin (Esplora, zpub), Filecoin (Filfox), NEAR (NearBlocks), Aleph Cloud credits – as @le-space/ledger entries. Browser and Node; fetch, endpoints and keys handed in.",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Le-Space/belege.git",
		"directory": "packages/chains"
	},
	"homepage": "https://github.com/Le-Space/belege/tree/main/packages/chains#readme",
	"sideEffects": false,
	"exports": {
		".": "./src/index.js",
		"./core": "./src/core.js",
		"./http": "./src/http.js",
		"./registry": "./src/registry.js",
		"./wallets": "./src/wallets.js",
		"./cosmos": "./src/cosmos.js",
		"./cosmos-chains": "./src/cosmos-chains.js",
		"./bech32": "./src/bech32.js",
		"./protobuf": "./src/protobuf.js",
		"./akash-console": "./src/akash-console.js",
		"./akash-deployments": "./src/akash-deployments.js",
		"./evm": "./src/evm.js",
		"./evm-address": "./src/evm-address.js",
		"./evm-contracts": "./src/evm-contracts.js",
		"./alchemy": "./src/alchemy.js",
		"./bitcoin": "./src/bitcoin.js",
		"./filecoin": "./src/filecoin.js",
		"./filecoin-chain": "./src/filecoin-chain.js",
		"./near": "./src/near.js",
		"./aleph": "./src/aleph.js",
		"./testing/cosmos": "./test/support/fake-cosmos.js",
		"./testing/filfox": "./test/support/fake-filfox.js"
	},
	"files": ["src", "test/support"],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "node --test --test-reporter=spec \"test/*.test.js\"",
		"lint": "prettier --check src test"
	},
	"dependencies": {
		"@le-space/ledger": "workspace:^",
		"@le-space/rates": "workspace:^",
		"@noble/hashes": "2.4.0",
		"@scure/base": "2.4.0",
		"@scure/bip32": "2.4.0"
	},
	"devDependencies": {
		"@le-space/browser-test": "workspace:*",
		"prettier": "3.6.2"
	}
}
