{
	"name": "@belege/bridge",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"version": "0.2.0",
	"description": "The belege bridge on 127.0.0.1: what a browser cannot do (Hibiscus XML-RPC, IMAP, the LLM call, customer portals).",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"belege-bridge": "src/cli.js"
	},
	"exports": {
		".": "./src/index.js",
		"./chains": "./src/chains/index.js",
		"./testing": "./test/support/fake-hibiscus.js",
		"./testing/imap": "./test/support/fake-imap.js",
		"./testing/llm": "./test/support/fake-llm.js",
		"./testing/pdf": "./test/support/synthetic-pdf.js",
		"./testing/portal": "./test/support/fake-portal.js",
		"./testing/kraken": "./test/support/fake-kraken.js",
		"./testing/enablebanking": "./test/support/fake-enablebanking.js",
		"./testing/filfox": "./test/support/fake-filfox.js",
		"./testing/chains": "./test/support/fake-chains.js",
		"./testing/alchemy": "./test/support/fake-alchemy.js",
		"./testing/aleph": "./test/support/fake-aleph.js"
	},
	"scripts": {
		"start": "node src/cli.js",
		"setup:hibiscus": "node src/setup-hibiscus.js",
		"setup:mail": "node src/setup-mail.js",
		"setup:llm": "node src/setup-llm.js",
		"setup:portal": "node src/setup-portal.js",
		"setup:kraken": "node src/setup-kraken.js",
		"setup:enablebanking": "node src/setup-enablebanking.js",
		"setup:coingecko": "node src/setup-coingecko.js",
		"setup:bitcoin": "node src/setup-bitcoin.js",
		"setup:alchemy": "node src/setup-alchemy.js",
		"setup:relay": "node src/setup-relay.js",
		"setup:aleph": "node src/setup-aleph.js",
		"test": "node --test --test-reporter=spec \"test/*.test.js\"",
		"lint": "prettier --check src test",
		"format": "prettier --write src test"
	},
	"dependencies": {
		"@chainsafe/libp2p-noise": "17.0.0",
		"@chainsafe/libp2p-yamux": "8.0.1",
		"@le-space/orbitdb-storage-bridge": "0.16.1",
		"@libp2p/circuit-relay-v2": "4.2.9",
		"@libp2p/crypto": "5.1.23",
		"@libp2p/identify": "4.1.10",
		"@libp2p/webrtc": "6.0.27",
		"@noble/curves": "2.4.0",
		"@noble/hashes": "2.4.0",
		"@peculiar/x509": "2.1.0",
		"@scure/base": "2.4.0",
		"@scure/bip32": "2.4.0",
		"fast-xml-parser": "5.11.1",
		"imapflow": "2.0.6",
		"libp2p": "3.3.7",
		"playwright": "1.61.1"
	},
	"devDependencies": {
		"hoodiecrow-imap": "2.1.0",
		"prettier": "3.6.2",
		"selfsigned": "5.5.0"
	}
}
