#!/bin/sh
# belege-bridge-run: start the hosted bridge (#583) with what came with the
# unlock (#584), then drop to its own user.
#
# Aleph's attestation agent writes every secret the owner's browser sent, after
# it checked this VM's attestation, to /tmp/secrets/<name>. Here they are
# sorted, as root, into a tmpfs only the bridge's user can read:
#
#   /run/belege-bridge/secrets/<account>  the keychain's accounts the bridge
#                                         knows (keychain.js, unlockedKeychain);
#                                         never the disk passphrase
#   /run/belege-bridge/bridge.json        from `bridge_config` (JSON), with the
#                                         node's WebSocket behind Caddy and the
#                                         VM's public name to announce
#   /run/belege-bridge/node/peer-key      from `bridge_peer_key` (base64), so the
#                                         peer id is the one the books know
#   /run/belege-bridge/enablebanking.sealed from `enablebanking_sealed`
#
# Nothing of it goes onto the rootfs; at the next start it comes again.
set -eu
in=/tmp/secrets
run=/run/belege-bridge
mkdir -p "$run"
mountpoint -q "$run" || mount -t tmpfs -o mode=0700,size=64m,nosuid,nodev,noexec tmpfs "$run"
chown belege-bridge:belege-bridge "$run"
chmod 700 "$run"
umask 077
install -d -o belege-bridge -g belege-bridge -m 700 "$run/secrets" "$run/node"

# The HTTPS name came with the unlock: Caddy serves /attest, the status and
# the node's WebSocket on it before the bridge starts.
host=""
if [ -s "$in/https_hostname" ]; then
  host="$(head -c 253 "$in/https_hostname" | tr -d '\r\n')"
  /usr/local/sbin/belege-bridge-https "$host" || host=""
fi

# The keychain's accounts, and nothing else (keychain.js secretFileOf). The
# dstack variant (#696) keeps the same list in bridge/tee/dstack/sort-secrets.mjs:
# change both together.
if [ -d "$in" ]; then
  for f in "$in"/*; do
    # One plain file per secret: a link is skipped, not followed.
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    name="$(basename "$f")"
    # A whole-name match, as sort-secrets.mjs's ACCOUNT: a case glob's `*`
    # would take any character after `portal_`.
    printf '%s\n' "$name" | grep -Eqx 'hibiscus|imap|llm|kraken|paperless|enablebanking|coingecko|bitcoin|alchemy|aleph_backup|bridge_auth|portal_[a-z0-9]+(_[a-z0-9]+)*' || continue
    install -o belege-bridge -g belege-bridge -m 600 "$f" "$run/secrets/$name"
  done
fi
if [ -s "$in/bridge_peer_key" ]; then
  base64 -d "$in/bridge_peer_key" > "$run/node/peer-key" 2>/dev/null || rm -f "$run/node/peer-key"
fi
if [ -s "$in/enablebanking_sealed" ]; then
  install -m 600 "$in/enablebanking_sealed" "$run/enablebanking.sealed"
fi

# bridge.json: what the owner's browser sent, with the hosted settings on top.
python3 - "$in/bridge_config" "$run/bridge.json" "$host" "$run/secrets/llm" <<'PY'
import json, os, re, sys
from urllib.parse import urlparse
src, dst, host, llm_key = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    with open(src) as f:
        config = json.load(f)
    if not isinstance(config, dict):
        config = {}
except Exception:
    config = {}
# A part that is not an object is the owner's mistake; it must not keep the bridge from starting.
for part in ("bridge", "node"):
    if not isinstance(config.get(part), dict):
        config[part] = {}
config["bridge"]["port"] = 8765
node = config["node"]
node["enabled"] = True
# Caddy passes wss://<host>/ on to this WebSocket (belege-bridge-https).
node["wsPort"] = 9097
node["announce"] = [f"/dns4/{host}/tcp/443/tls/ws"] if host else []
# A language model only in LibertAI's attested enclave, pinned by setup:llm
# (#754; before it none, #251): sort-secrets.mjs `enclaveLlm` decides the same.
def enclave_llm(llm):
    if not isinstance(llm, dict):
        return None
    tee = llm.get("tee")
    if not isinstance(tee, dict) or tee.get("provider") != "libertai":
        return None
    if not re.fullmatch(r"[0-9a-f]{64}", str(tee.get("itemHash", ""))):
        return None
    if not re.fullmatch(r"[0-9a-fA-F]{32,}", str(tee.get("measurement", ""))):
        return None
    try:
        base = urlparse(str(llm.get("baseUrl", "")))
    except Exception:
        return None
    if base.scheme != "https" or base.hostname != "api.libertai.io":
        return None
    def text(v):
        return v if isinstance(v, str) and len(v) <= 200 else None
    model = text(llm.get("model"))
    if not model:
        return None
    terms = llm.get("redactTerms")
    return {
        "baseUrl": str(llm["baseUrl"]).rstrip("/"),
        "model": model,
        "retryModel": text(llm.get("retryModel")) or model,
        "redactTerms": [t for t in terms if isinstance(t, str)][:500] if isinstance(terms, list) else [],
        "redaction": llm.get("redaction") if llm.get("redaction") in ("auto", "on", "off") else "auto",
        "configured": True,
        "tee": {
            "provider": "libertai",
            "itemHash": str(tee["itemHash"]),
            "measurement": str(tee["measurement"]),
            "sourceCommit": tee.get("sourceCommit") if isinstance(tee.get("sourceCommit"), str) else None,
            "pinnedAt": str(tee.get("pinnedAt", "")),
        },
    }
llm = enclave_llm(config.pop("llm", None))
if llm:
    config["llm"] = llm
elif os.path.exists(llm_key):
    # The model's key only beside a model in the enclave.
    os.remove(llm_key)
# Settings taken over from a bridge on a computer (#728) may name its own
# network: the relay for devices in the LAN and the old HTTP tokens. Neither
# belongs in the VM, where nothing but Caddy listens beyond loopback.
config.pop("lanRelay", None)
config.pop("pairedTokens", None)
with open(dst, "w") as f:
    json.dump(config, f)
PY
chown -R belege-bridge:belege-bridge "$run/bridge.json" "$run/node"
[ -f "$run/enablebanking.sealed" ] && chown belege-bridge:belege-bridge "$run/enablebanking.sealed"

exec setpriv --reuid belege-bridge --regid belege-bridge --init-groups --no-new-privs \
  env -i PATH=/usr/bin:/bin HOME="$run" NODE_ENV=production BELEGE_BRIDGE_SECRETS_DIR="$run/secrets" \
  /usr/bin/node /opt/belege-bridge/src/cli.js --hosted --config "$run/bridge.json"
