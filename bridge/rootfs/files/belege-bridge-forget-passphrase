#!/bin/sh
# belege-bridge-forget-passphrase: the disk passphrase does not stay in
# memory. Aleph's measured init zeroes and removes /tmp/secrets/luks_passphrase
# once it has opened the disk; when the owner's browser hands the secrets over
# again (a second unlock after no answer), the agent stores it once more and
# nothing reads it. This zeroes and removes it whenever it appears, as
# Le-Space/paperless-anywhere's paperless-forget-passphrase does.
set -u
f=/tmp/secrets/luks_passphrase
while :; do
  if [ -e "$f" ]; then
    size="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    [ "$size" -gt 0 ] && dd if=/dev/zero of="$f" bs=1 count="$size" conv=notrunc 2>/dev/null
    rm -f "$f"
    echo "belege-bridge-forget-passphrase: removed a passphrase handed over again"
  fi
  sleep 2
done
