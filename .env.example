# Copy to .env (git-ignored) and fill in. Never commit .env.
# Phase 0 spikes only. The bridge keeps its secrets in the macOS keychain: `pnpm setup:mail`
# and `pnpm setup:llm` offer the IMAP_* and DEEPSEEK_* values below once, then you can delete them.

# IMAP mailbox with receipts (spike: pnpm spike:imap)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Alias that receipts are sent to; --accounting only reads mails addressed to it
IMAP_ACCOUNTING_ADDRESS=buchhaltung@le-space.de

# LLM (spike: pnpm spike:llm-key). The key never leaves this machine except to that API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Terms to black out before any text goes to an LLM, separated by semicolons
# (own name, family names on tickets, …). IBANs, own-domain e-mails, streets and postcodes
# are blacked out anyway.
REDACT_TERMS=

# Hibiscus (spike: pnpm spike:hibiscus). Phase 0 only: the bridge will keep the master
# password in the macOS keychain. Leave it out here if you prefer `read -s HIBISCUS_PASSWORD`.
HIBISCUS_PASSWORD=
# SHA-256 fingerprint of Jameica's certificate, printed by the first run
HIBISCUS_CERT_SHA256=
# Only accounts whose IBAN ends in one of these (comma-separated) are read; others are skipped.
HIBISCUS_IBAN_SUFFIX=

# Enable Banking (spike: node spikes/enablebanking/probe.mjs). Not secret: the key file is.
EB_APP_ID=
# Path to the .pem the Enable Banking Control Panel downloaded; keep it outside the repo, mode 0600
EB_KEY_PATH=~/.config/belege/enablebanking/app.pem
# Redirect URL exactly as registered for the application
EB_REDIRECT_URL=

# Kraken, read only (pnpm setup:kraken offers these once, then keeps them in the keychain).
# Create the key with only "Query Funds" and "Query Ledger Entries".
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
# Bitcoin wallet, read only: the account's xpub, ypub or zpub (pnpm setup:bitcoin offers it once, then keeps it in the keychain)
BITCOIN_XPUB=
# CoinGecko demo key, optional: more requests for daily rates (pnpm setup:coingecko)
COINGECKO_API_KEY=
