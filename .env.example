# Copy to .env (git-ignored) and fill in. Never commit .env.
# Phase 0 only: later the bridge keeps these in the macOS keychain.

# IMAP mailbox with receipts (spike: pnpm spike:imap)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Alias that receipts are sent to; --accounting only reads mails addressed to it
IMAP_ACCOUNTING_ADDRESS=buchhaltung@le-space.de
