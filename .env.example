# Copy to .env (git-ignored) and fill in. Never commit .env.
# Phase 0 only: later the bridge keeps these in the macOS keychain.

# IMAP mailbox with receipts (spike: pnpm spike:imap)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Alias that receipts are sent to; --accounting only reads mails addressed to it
IMAP_ACCOUNTING_ADDRESS=buchhaltung@le-space.de

# LLM (spike: pnpm spike:llm-key). The key never leaves this machine except to that API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Terms to black out before any text goes to an LLM, separated by semicolons
# (own name, family names on tickets, …). IBANs, own-domain e-mails, streets and postcodes
# are blacked out anyway.
REDACT_TERMS=

# Hibiscus (spike: pnpm spike:hibiscus). Phase 0 only: the bridge will keep the master
# password in the macOS keychain. Leave it out here if you prefer `read -s HIBISCUS_PASSWORD`.
HIBISCUS_PASSWORD=
# SHA-256 fingerprint of Jameica's certificate, printed by the first run
HIBISCUS_CERT_SHA256=
# Only accounts whose IBAN ends in one of these (comma-separated) are read; others are skipped.
HIBISCUS_IBAN_SUFFIX=
