# Copy to .env (git-ignored) and fill in. Never commit .env.
# The bridge keeps its secrets in the macOS keychain, not here. The bridge's `pnpm setup:*`
# scripts offer the values below once when they find them in .env (`setup:mail` the IMAP_*,
# `setup:llm` the DEEPSEEK_* and REDACT_TERMS, and so on); after that you can delete them.

# IMAP mailbox with receipts (pnpm setup:mail)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Alias that receipts are sent to, e.g. receipts@example.com
IMAP_ACCOUNTING_ADDRESS=

# LLM (pnpm setup:llm). The key never leaves this machine except to that API.
# The bridge's default is Ollama on this computer; `pnpm setup:llm` offers these only
# when you choose a provider on the internet (choice 3) on purpose.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Terms to black out before any text goes to an LLM, separated by semicolons
# (own name, family names on tickets, …). IBANs, own-domain e-mails, streets and postcodes
# are blacked out anyway.
REDACT_TERMS=

# Hibiscus: `pnpm setup:hibiscus` keeps the master password in the macOS keychain. Leave it
# out here if you prefer to type it when the setup asks.
HIBISCUS_PASSWORD=

# Enable Banking (pnpm setup:enablebanking offers these). Not secret: the key file is.
EB_APP_ID=
# Path to the .pem the Enable Banking Control Panel downloaded; keep it outside the repo, mode 0600
EB_KEY_PATH=~/.config/belege/enablebanking/app.pem
# Redirect URL exactly as registered for the application
EB_REDIRECT_URL=

# Kraken, read only (pnpm setup:kraken offers these once, then keeps them in the keychain).
# Create the key with only "Query Funds" and "Query Ledger Entries".
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
# Bitcoin wallet, read only: the account's xpub, ypub or zpub (pnpm setup:bitcoin offers it once, then keeps it in the keychain)
BITCOIN_XPUB=
# CoinGecko demo key, optional: more requests for daily rates (pnpm setup:coingecko)
COINGECKO_API_KEY=
# Paperless-ngx API token (pnpm setup:paperless offers it once, then keeps it in the keychain)
PAPERLESS_API_TOKEN=
